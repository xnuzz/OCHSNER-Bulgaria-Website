# OCHSNER site on SuperHosting (Apache). Does what vercel.json does on Vercel.
# The security headers are appended at the end by scripts/package-superhosting.mjs.

Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# One address per page for search engines: https, no www, in a single hop
# (http://www.ochsner.bg/x -> https://ochsner.bg/x)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# API: catalog data is pre-built JSON, the two forms are PHP
RewriteRule ^api/v1/(products|references|social)/?$ api/v1/$1.json [END]
RewriteRule ^api/v1/(contact|partner-applications|newsletter)/?$ api/v1/$1.php [END]
RewriteRule ^api(/|$) - [R=404,L]

# A missing file (the old site's /files/*.pdf, a stale asset) is a real 404, not
# the app with a 200, so search engines drop it. Visitors still get the app's
# branded "not found" page via ErrorDocument.
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.[a-z0-9]{2,5}$ [NC]
RewriteRule ^ - [R=404,L]

# Retired page, still indexed: a real 301 passes its ranking on to the home page.
RewriteRule ^zashto-termopompa/?$ /#kak-raboti [R=301,NE,QSD,L]

# Every page is prerendered to <path>/index.html. Serve it at the slash-less URL the
# sitemap and canonical tags use; the trailing-slash form is sent there with a 301.
DirectorySlash Off
RewriteRule ^(.+)/$ /$1 [R=301,L]
# .../index.html typed or linked directly (not our own rewrite below) -> the clean URL
RewriteCond %{THE_REQUEST} /index\.html[\s?]
RewriteRule ^(?:(.+)/)?index\.html$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Anything else (a retired product URL, a typo) goes to the Vue router, which
# redirects or shows "not found".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.html [L]

<IfModule mod_headers.c>
  # Vite fingerprints everything in /assets, so it can be cached forever
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

