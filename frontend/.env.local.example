# Copy to `.env.local` (gitignored) to test the contact/partner forms locally.
# These are read server-side by api/_lib/notify.js — the same variables you set
# in Vercel. Only VITE_-prefixed values ever reach the browser.
#
# Gmail needs an App Password, not your normal password: enable 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords
# For Gmail, MAIL_FROM must match SMTP_USERNAME or the message is rejected.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
NOTIFY_EMAIL=your.address@gmail.com
MAIL_FROM=your.address@gmail.com

# Canonical/og:url base. Set to the deployed origin; defaults to https://ochsner.bg
# VITE_SITE_URL=http://localhost:5173
