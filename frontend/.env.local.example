# Copy to `.env.local` (gitignored) to test the contact/partner forms locally.
# These are read server-side by api/_lib/notify.js — the same variables you set
# in Vercel. Only VITE_-prefixed values ever reach the browser.
#
# Gmail needs an App Password, not your normal password: enable 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords
# For Gmail, MAIL_FROM must match SMTP_USERNAME or the message is rejected.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
NOTIFY_EMAIL=your.address@gmail.com
MAIL_FROM=your.address@gmail.com

# Canonical/og:url base. Set to the deployed origin; defaults to https://ochsner.bg
# VITE_SITE_URL=http://localhost:5173

# --- Social feed (Facebook + Instagram) ------------------------------------
# Read server-side by api/_lib/social.js. Leave these unset and the section
# serves clearly-labelled sample posts, so it is presentable before the client
# has connected anything.
#
# Meta exposes posts only for accounts you own — there is no way to read an
# arbitrary public profile. To go live you need:
#   1. A Facebook Page (not a personal profile).
#   2. An Instagram Business or Creator account linked to that Page.
#   3. A Meta app (developers.facebook.com) with the Page connected.
#   4. A LONG-LIVED Page access token with: pages_read_engagement,
#      pages_show_list, instagram_basic.
#      Short-lived tokens expire in ~1 hour — exchange for the 60-day one.
#   5. Live-mode App Review for those permissions before public traffic.
#
# Find the ids: FB_PAGE_ID   -> GET /me/accounts
#               IG_USER_ID   -> GET /{page-id}?fields=instagram_business_account
#
# META_ACCESS_TOKEN=EAAG...
# FB_PAGE_ID=1234567890
# IG_USER_ID=1784...
# SOCIAL_CACHE_TTL=900
#
# Optional: also pull posts from ANOTHER public Instagram Business account
# (e.g. the manufacturer's official profile) via the business_discovery edge.
# Only Business/Creator accounts are readable this way — personal profiles are
# not exposed by Meta at all. Needs instagram_manage_insights in addition.
# IG_DISCOVER_USERNAME=ochsner_waermepumpen
