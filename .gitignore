# Java / Maven
backend/target/
backend/data/
*.class

# Node / Vite — match at any depth, not just under frontend/
node_modules/
dist/
.vite/
npm-debug.log*

# Env & secrets. Broad by design: anything .env* is ignored except the
# committed template, so a new .env.production can never slip in by accident.
.env
.env.*
!.env.local.example
*.local
*.pem
*.key
*.p12
*.keystore

# Raw asset dump from the manufacturer — staging only. Finals are copied
# into frontend/public/images/ and committed from there.
assets-inbox/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Client-facing commercial documents (pricing, proposal). Deliberately kept out
# of the repo: this code ships to the client and may become public.
/*.txt
/*.pdf
